---
import { Icon } from 'astro-icon/components';
import { services } from '../data/services';
---

<section id="services">
  <div class="container">
    <div class="services-head">
      <div>
        <div class="section-label fade-up">Servicios</div>
        <h2 class="section-title fade-up" style="margin:0">¿En qué puedo <span class="accent">ayudarte?</span></h2>
      </div>
      <div class="carousel-nav fade-up">
        <button class="car-btn" id="svcPrev" type="button" aria-label="Ver servicios anteriores">
          <Icon name="lucide:chevron-left" />
        </button>
        <button class="car-btn" id="svcNext" type="button" aria-label="Ver más servicios">
          <Icon name="lucide:chevron-right" />
        </button>
      </div>
    </div>

    <div class="svc-carousel fade-up">
      <ul class="svc-track" id="svcTrack">
        {services.map(s => (
          <li class="svc-card">
            <Icon name={`lucide:${s.icon}`} class="svc-icon" />
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <div class="tags-row">
              {s.tags.map(t => <span class="tag">{t}</span>)}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('svcTrack');
  const prev  = document.getElementById('svcPrev') as HTMLButtonElement | null;
  const next  = document.getElementById('svcNext') as HTMLButtonElement | null;

  if (track && prev && next) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const step = () => {
      const card = track.querySelector<HTMLElement>('.svc-card');
      const gap = parseFloat(getComputedStyle(track).columnGap || '16') || 16;
      return card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
    };

    const scrollByStep = (dir: number) =>
      track.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => scrollByStep(-1));
    next.addEventListener('click', () => scrollByStep(1));

    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .services-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .carousel-nav { display: flex; gap: .5rem; flex-shrink: 0; }
  .car-btn {
    width: 40px; height: 40px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color .2s cubic-bezier(.4,0,.2,1), color .2s cubic-bezier(.4,0,.2,1), opacity .2s;
  }
  .car-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .car-btn:disabled { opacity: .35; cursor: default; }
  .car-btn svg { width: 18px; height: 18px; }

  /* Carrusel */
  .svc-track {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: .25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .svc-track::-webkit-scrollbar { display: none; }

  .svc-card {
    flex: 0 0 clamp(240px, 31%, 300px);
    scroll-snap-align: start;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .55rem;
    transition: border-color .3s cubic-bezier(.4,0,.2,1), transform .3s cubic-bezier(.4,0,.2,1);
  }
  .svc-card:hover { border-color: rgba(45,212,191,.35); transform: translateY(-3px); }

  .svc-icon { width: 1.9rem; height: 1.9rem; color: var(--accent); }
  .svc-card h3 { font-size: 1.05rem; }
  .svc-card p { font-size: .86rem; color: var(--muted); margin: 0; flex: 1; }
  .tags-row { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .4rem; }

  @media (max-width: 768px) {
    .svc-card { flex-basis: 82%; }
  }
</style>
