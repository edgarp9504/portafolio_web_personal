---
import { stackGroups } from '../data/stack';
---

<section id="stack">
  <div class="container">
    <div class="section-label fade-up">Stack tecnológico</div>
    <h2 class="section-title fade-up">Herramientas que <span class="accent">domino.</span></h2>
    <p class="section-sub fade-up">No colecciono tecnologías. Cada herramienta la he usado en producción.</p>

    {stackGroups.map(g => (
      <div class="stack-group fade-up">
        <div class="stack-group-title">{g.label}</div>
        <div class="stack-items">
          {g.items.map(i => <span class="stack-item">{i}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .stack-group { margin-bottom: 2.5rem; }
  .stack-group-title {
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 1rem;
    padding-bottom: .5rem;
    border-bottom: 1px solid var(--border);
  }
  .stack-items { display: flex; flex-wrap: wrap; gap: .75rem; }
  .stack-item {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: .6rem 1.1rem;
    font-size: .88rem;
    font-weight: 500;
    color: var(--text);
    transition: border-color .25s cubic-bezier(.4,0,.2,1), color .25s cubic-bezier(.4,0,.2,1), transform .25s cubic-bezier(.4,0,.2,1);
  }
  .stack-item::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: .6;
    flex-shrink: 0;
  }
  .stack-item:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }
</style>
